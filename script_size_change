=======================================================================
Script to change mkv to mp4 by choosing a size 
subtitles can be togglable or burn in
also, can be from inbuilt or outside file
=======================================================================
import subprocess
import os
from tqdm import tqdm
from pathlib import Path
# =========================
# CONFIG
# =========================
FOLDER = "./"
SEASON = "s01"
EPISODE = "e01"
VIDEO = f"{FOLDER}{EPISODE}.mkv"
for item in Path(".").iterdir():
    if item.suffix == ".mkv":
        VIDEO = f"{FOLDER}{item}"
SUBTITLE = f"{FOLDER}{EPISODE}.srt"
OUTPUT = f"{FOLDER}{SEASON}{EPISODE}.mp4"

TARGET_SIZE_MB = 1900

SUBTITLE_TOGGLABLE = False
SUBTITLE_INBUILT = False
SUBTITLE_TRACK   = 0  # 0-indexed (0 = 1st subtitle track)

# =========================
# 1. SMART SUBTITLE CHECK
# =========================
has_subtitle = False

if SUBTITLE_INBUILT:
    try:
        # Check if internal subtitle track exists
        sub_probe = subprocess.check_output([
            "ffprobe", "-v", "error",
            "-select_streams", f"s:{SUBTITLE_TRACK}",
            "-show_entries", "stream=index",
            "-of", "csv=p=0", VIDEO
        ]).decode().strip()
        
        if sub_probe:
            has_subtitle = True
        else:
            print(f"Warning: Internal subtitle track '{SUBTITLE_TRACK}' not found in {VIDEO}.")
            print("Proceeding without subtitles...\n")
    except Exception:
        print(f"Warning: Could not read internal subtitles from {VIDEO}.")
        print("Proceeding without subtitles...\n")
else:
    if os.path.exists(SUBTITLE):
        has_subtitle = True
    else:
        print(f"Warning: External subtitle file '{SUBTITLE}' not found.")
        print("Proceeding without subtitles...\n")

# =========================
# 2. GET DURATION & AUDIO
# =========================
print(f"{SEASON}-{EPISODE}")
duration_str = subprocess.check_output([
    "ffprobe", "-v", "error", "-show_entries", "format=duration",
    "-of", "default=noprint_wrappers=1:nokey=1", VIDEO
]).decode().strip()
duration = float(duration_str)

audio_bitrate_str = subprocess.check_output([
    "ffprobe", "-v", "error", "-select_streams", "a:0",
    "-show_entries", "stream=bit_rate",
    "-of", "default=noprint_wrappers=1:nokey=1", VIDEO
]).decode().strip()

# Handle missing or multi-line audio bitrate info safely
if audio_bitrate_str:
    first_audio = audio_bitrate_str.split("\n")[0]
    audio_bitrate = int(first_audio) // 1000 if first_audio.isdigit() else 128
else:
    audio_bitrate = 128

# =========================
# 3. CALCULATE BITRATE
# =========================
video_bitrate = int(((TARGET_SIZE_MB * 8192) / duration) - audio_bitrate)

print(f"Duration      : {duration:.0f} sec")
print(f"Audio bitrate : {audio_bitrate} kbps")
print(f"Video bitrate : {video_bitrate} kbps")
print(f"Subtitles     : {'Enabled' if has_subtitle else 'Disabled'}\n")

# =========================
# 4. BUILD COMMAND
# =========================
cmd = ["ffmpeg", "-i", VIDEO]

if not has_subtitle:
    # No subtitles found - basic video & audio map
    cmd.extend([
        "-map", "0:v:0",
        "-map", "0:a:0",
        "-c:v", "hevc_nvenc",
        "-preset", "p5",
        "-b:v", f"{video_bitrate}k",
        "-c:a", "copy"
    ])
else:
    if SUBTITLE_TOGGLABLE:
        if SUBTITLE_INBUILT:
            cmd.extend([
                "-map", "0:v:0", "-map", "0:a:0", "-map", f"0:s:{SUBTITLE_TRACK}",
                "-c:v", "hevc_nvenc", "-preset", "p5", "-b:v", f"{video_bitrate}k",
                "-c:a", "copy", "-c:s", "mov_text"
            ])
        else:
            cmd = ["ffmpeg", "-i", VIDEO, "-i", SUBTITLE] # Rebuild to include 2nd input
            cmd.extend([
                "-map", "0:v:0", "-map", "0:a:0", "-map", "1:0",
                "-c:v", "hevc_nvenc", "-preset", "p5", "-b:v", f"{video_bitrate}k",
                "-c:a", "copy", "-c:s", "mov_text"
            ])
    else:
        # Burned-in subtitles
        if SUBTITLE_INBUILT:
            # Escape paths for FFmpeg filter
            safe_video = VIDEO.replace("\\", "/").replace(":", "\\:")
            cmd.extend([
                "-vf", f"subtitles='{safe_video}':si={SUBTITLE_TRACK}",
                "-c:v", "hevc_nvenc", "-preset", "p5", "-b:v", f"{video_bitrate}k",
                "-c:a", "copy"
            ])
        else:
            safe_sub = SUBTITLE.replace("\\", "/").replace(":", "\\:")
            cmd.extend([
                "-vf", f"subtitles='{safe_sub}'",
                "-c:v", "hevc_nvenc", "-preset", "p5", "-b:v", f"{video_bitrate}k",
                "-c:a", "copy"
            ])

# Common tail arguments
cmd.extend([
    "-movflags", "+faststart",
    "-progress", "pipe:1",
    "-nostats",
    OUTPUT
])

# =========================
# 5. RUN + ERROR CATCHING
# =========================
# Note: Redirecting stderr to stdout to catch fatal errors
process = subprocess.Popen(
    cmd,
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT, 
    text=True,
    encoding='utf-8',
    errors='replace'
)

pbar = tqdm(total=duration, unit="sec", desc="Encoding")
error_buffer = []

for line in process.stdout:
    line = line.strip()
    if line.startswith("out_time_ms="):
        try:
            current = int(line.split("=")[1]) / 1_000_000
            pbar.n = min(current, duration)
            pbar.refresh()
        except ValueError:
            pass
    elif line:
        # Save lines to an error buffer just in case it crashes
        error_buffer.append(line)
        if len(error_buffer) > 20: 
            error_buffer.pop(0)

pbar.close()
process.wait()

# If FFmpeg crashes, print the exact reason
if process.returncode != 0:
    print("\n[!] FFmpeg failed! Last error logs:")
    print("-" * 40)
    for err in error_buffer:
        print(err)
    print("-" * 40)
else:
    print("\nDone!")
